# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Any Gemini model with vision works; see PRICES in server/src/config.ts.
GEMINI_MODEL=gemini-3.8-flash
# Optional. Tried in order when the main model is overloaded.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash,gemini-3.5-flash-lite
